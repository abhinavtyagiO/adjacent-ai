# Reference only; .env already contains these public defaults.
# Copy this file to .env.local for private overrides and set your selected provider's key.
DATABASE_URL=postgresql+psycopg://brand:brand@localhost:5432/brand_intelligence
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=3
CRAWL_MAX_PAGES=10
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_BYTES=2000000
CRAWL_MAX_TEXT_CHARS=12000
JOB_TIMEOUT_SECONDS=240
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO
# Optional shared token for /v1 routes. Set before exposing beyond localhost.
API_ACCESS_TOKEN=
# PostgreSQL only; use a separate disposable database for integration tests.
TEST_DATABASE_URL=postgresql+psycopg://brand:brand@localhost:5433/brand_intelligence_test
