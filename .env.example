# Reference only; .env already contains these public defaults.
# Copy this file to .env.local for private overrides and set your selected provider's key.
DATABASE_URL=postgresql+psycopg://brand:brand@localhost:5432/brand_intelligence
EXTRACTION_MODE=draft_first
FACTUAL_CONTEXT_MAX_CHARS=60000
LLM_PROVIDER=openai_chatgpt
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=90
# Per-stage deadlines; total job timeout still applies.
FACTUAL_TIMEOUT_SECONDS=120
MARKETING_TIMEOUT_SECONDS=60
MARKETING_CONTEXT_MAX_CHARS=18000
LLM_MAX_ATTEMPTS=1
CATALOG_MAX_PAGES=3
CATALOG_MAX_PRODUCTS=1000
CRAWL_MAX_PAGES=20
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_BYTES=2000000
CRAWL_MAX_TEXT_CHARS=12000
JOB_TIMEOUT_SECONDS=420
JOB_LEASE_SECONDS=480
JOB_MAX_ATTEMPTS=1
WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO
# Optional shared token for /v1 routes. Set before exposing beyond localhost.
API_ACCESS_TOKEN=
# PostgreSQL only; use a separate disposable database for integration tests.
TEST_DATABASE_URL=postgresql+psycopg://brand:brand@localhost:5433/brand_intelligence_test

# Blank stage models use the selected account model. Choose it through ChatGPT connection settings.
FACTUAL_MODEL=
MARKETING_MODEL=
FACTUAL_REASONING_EFFORT=
MARKETING_REASONING_EFFORT=
FACTUAL_MAX_OUTPUT_TOKENS=24000
MARKETING_MAX_OUTPUT_TOKENS=12000
LLM_MAX_INPUT_TOKENS=50000
LLM_MAX_TOTAL_TOKENS=160000
CRAWL_MAX_REQUESTS=40
CRAWL_MAX_TOTAL_CHARS=140000
CRAWL_MAX_SITEMAPS=4
CRAWL_MAX_ELAPSED_SECONDS=90

# Blank effort uses the selected ChatGPT model default; explicit efforts must be model-supported.
# Optional cost assumptions (USD per million tokens); uncomment only with known rates.
# LLM_INPUT_USD_PER_MILLION=0.30
# LLM_OUTPUT_USD_PER_MILLION=1.20
# LLM_CACHED_INPUT_USD_PER_MILLION=0.006
OPENAI_API_KEY_BILLING_ENABLED=false
CHATGPT_DEPLOYMENT_MODE=local
CHATGPT_REDIRECT_URI=http://127.0.0.1:8000/v1/chatgpt/callback
CHATGPT_AUTH_DIR=.local/chatgpt

# Content-first allocation inside the existing global crawl ceilings.
# Partial JSON overrides merge with defaults; limits count attempted content URLs.
CRAWL_CATEGORY_LIMITS={"customer_story":3,"brand_assets":2,"use_case":3,"brand_story":2,"faq":2,"education":2,"audience_content":2,"category":4,"product":3,"pricing":1}
CRAWL_SKIP_ALTERNATE_LOCALES=true
CRAWL_MAX_STYLESHEETS=2
# Exact company -> external kit host mapping. A company-site brand/press link is also required.
CRAWL_BRAND_ASSET_HOSTS={"opalapp.com":["brandkit.opal.so"]}

# Phase 2A: two bounded requests using the existing authorized provider/model.
CREATIVE_CONTEXT_MAX_CHARS=30000
CREATIVE_MAX_INPUT_TOKENS=20000
CREATIVE_GENERATOR_MAX_OUTPUT_TOKENS=8000
CREATIVE_EVALUATOR_MAX_OUTPUT_TOKENS=4000
CREATIVE_GENERATOR_TIMEOUT_SECONDS=120
CREATIVE_EVALUATOR_TIMEOUT_SECONDS=60

# Phase 2B: private media and local Remotion rendering.
PIXABAY_API_KEY=
MEDIA_STORAGE_PATH=.local/media
MEDIA_MAX_BYTES=67108864
MEDIA_PROCESS_TIMEOUT_SECONDS=45
RENDER_TIMEOUT_SECONDS=360
RENDER_CONCURRENCY=2
# Set the local Chrome or Chromium executable before starting the render worker.
# RENDER_BROWSER_EXECUTABLE=/absolute/path/to/chromium
