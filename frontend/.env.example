# The frontend makes requests to FastAPI from its server.
ADJACENT_API_URL=http://127.0.0.1:8000
ADJACENT_API_TOKEN=

# Enable this only for local testing on the configured loopback origin.
ADJACENT_LOCAL_AUTH=false
ADJACENT_LOCAL_ORIGIN=http://127.0.0.1:3000
ADJACENT_LOCAL_PASSPHRASE=
ADJACENT_SESSION_SECRET=
