# Public development defaults. Keep credentials blank in this tracked file.
# Put private values in ignored .env.local or exported environment variables.
DATABASE_URL=postgresql+psycopg://brand:brand@localhost:5432/brand_intelligence
LLM_PROVIDER=openai_chatgpt
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=90
# Per-stage deadlines; total job timeout still applies.
FACTUAL_TIMEOUT_SECONDS=120
MARKETING_TIMEOUT_SECONDS=60
MARKETING_CONTEXT_MAX_CHARS=18000
LLM_MAX_ATTEMPTS=1
CRAWL_MAX_PAGES=20
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_BYTES=2000000
CRAWL_MAX_TEXT_CHARS=12000
JOB_TIMEOUT_SECONDS=420
JOB_LEASE_SECONDS=480
JOB_MAX_ATTEMPTS=1
WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO
API_ACCESS_TOKEN=
# Tests require this explicitly exported; pytest does not read it from dotenv.
TEST_DATABASE_URL=postgresql+psycopg://brand:brand@localhost:5433/brand_intelligence_test

# Blank stage models use the selected account model. Choose it through ChatGPT connection settings.
FACTUAL_MODEL=
MARKETING_MODEL=
FACTUAL_REASONING_EFFORT=
MARKETING_REASONING_EFFORT=
FACTUAL_MAX_OUTPUT_TOKENS=24000
MARKETING_MAX_OUTPUT_TOKENS=12000
LLM_MAX_INPUT_TOKENS=50000
LLM_MAX_TOTAL_TOKENS=160000
CRAWL_MAX_REQUESTS=40
CRAWL_MAX_TOTAL_CHARS=140000
CRAWL_MAX_SITEMAPS=4
CRAWL_MAX_ELAPSED_SECONDS=90

# Blank effort uses the selected ChatGPT model default; explicit efforts must be model-supported.
# Optional cost assumptions (USD per million tokens); uncomment only with known rates.
# LLM_INPUT_USD_PER_MILLION=0.30
# LLM_OUTPUT_USD_PER_MILLION=1.20
# LLM_CACHED_INPUT_USD_PER_MILLION=0.006
OPENAI_API_KEY_BILLING_ENABLED=false
CHATGPT_DEPLOYMENT_MODE=local
CHATGPT_REDIRECT_URI=http://127.0.0.1:8000/v1/chatgpt/callback
CHATGPT_AUTH_DIR=.local/chatgpt
