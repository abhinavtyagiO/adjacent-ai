FROM node:22.20.0-bookworm-slim AS node

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
WORKDIR /srv/app
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
RUN apt-get update && apt-get install -y --no-install-recommends     chromium ffmpeg fonts-liberation && rm -rf /var/lib/apt/lists/*
WORKDIR /srv/app/video-renderer
COPY video-renderer/package*.json video-renderer/tsconfig.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY video-renderer/src ./src
WORKDIR /srv/app
COPY app ./app
RUN useradd --create-home app && mkdir -p /srv/media && chown app:app /srv/media && chmod 700 /srv/media
ARG APP_BUILD_REVISION
ENV APP_BUILD_REVISION=${APP_BUILD_REVISION}
LABEL org.opencontainers.image.revision=${APP_BUILD_REVISION}
USER app
CMD ["python", "-m", "app.video.worker"]
